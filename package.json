{
  "name": "simulateur-chaussettes",
  "version": "0.1.0",
  "description": "Simulateur de chaussettes jacquard César Bazaar (aperçu 3D + grille de mailles)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "dev:api": "npm run build && npm run db:migrate:local && wrangler dev --port 4173",
    "db:migrate:local": "wrangler d1 migrations apply simulateur-chaussettes --local",
    "db:migrate:remote": "wrangler d1 migrations apply simulateur-chaussettes --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.workers.config.ts",
    "e2e": "playwright test",
    "e2e:api": "playwright test -c playwright.api.config.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "sync:carreaux": "node scripts/sync-carreaux.mjs",
    "sync:local": "node scripts/sync-carreaux.mjs --local-only"
  },
  "author": "César Bazaar",
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.140.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
